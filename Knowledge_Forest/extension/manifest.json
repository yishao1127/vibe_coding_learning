{
  "manifest_version": 3,
  "name": "知识森林采集助手",
  "version": "0.1.0",
  "description": "一键采集当前页面或选中片段，交给知识森林后端自动分类整理进飞书知识库。",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8799/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "采集当前页面到知识森林"
  },
  "icons": {}
}
